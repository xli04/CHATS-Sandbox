Classic YAML gotcha — `on:` parses as the boolean `True`. Let me fix the validator:
╰──────────────────────────────────────────────────────────────────────────────╯
  ┊ 💻 preparing terminal…
  ┊ 💻 $         python3 -c "
import yaml, sys

files = ['.github/workflows/ci.yml', '.github/workflows/deploy.yml']
ok = True
for f in files:
    try:
        with open(f) as fh:
            doc = yaml.safe_load(fh)
        # 'on' is parsed as boolean True in YAML 1.1
        trigger_key = True if 'on' not in doc else 'on'
        assert 'name' in doc, 'missing name'
        assert trigger_key in doc, 'missing on/trigger block'
        assert 'jobs' in doc, 'missing jobs'
        jobs = doc['jobs']
        job_names = list(jobs.keys())
        for job_name, job in jobs.items():
            assert 'runs-on' in job or 'uses' in job, f'{job_name}: missing runs-on'
            needs = job.get('needs', [])
            if isinstance(needs, str):
                needs = [needs]
            for dep in needs:
                assert dep in jobs, f'{job_name}: needs unknown job \"{dep}\"'
        print(f'OK  {f}  jobs={job_names}')
    except Exception as e:
        print(f'FAIL {f}: {e}')
        ok = False

sys.exit(0 if ok else 1)
"
  0.2s

